{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Longbow",
  "version": "1.2.0",
  "identifier": "dev.cullenwerks.longbow",
  "build": {
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "Longbow",
        "width": 1400,
        "height": 850,
        "minWidth": 1100,
        "minHeight": 700
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": ["resources/*"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
